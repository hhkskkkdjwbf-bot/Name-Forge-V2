+/**
+ * Interface labels of the shared UI modules for the languages added after the original 25 (uk, bn, nb).
+ * Each module getter consults this table first (see `getAddedLanguageLabels`).
+ */
+export type AddedLanguage = 'uk' | 'bn' | 'nb';
+export const ADDED_LANGUAGES: readonly AddedLanguage[] = ['uk', 'bn', 'nb'];
+
+/** Legacy codes kept for compatibility with settings stored by earlier versions. */
+export const LANGUAGE_ALIASES: Record<string, string> = { no: 'nb' };
+
+export function canonicalLanguage(language: string): string {
+  return LANGUAGE_ALIASES[language] || language;
+}
