+const PARSED: Record<string, Record<string, string[]>> = {};
+
+function parse(generatorId: string): Record<string, string[]> {
+  if (PARSED[generatorId]) return PARSED[generatorId];
+  const table: Record<string, string[]> = {};
+  for (const line of (RAW_BANKS[generatorId] || '').split('\n')) {
+    const idx = line.indexOf(': ');
+    if (idx < 0) continue;
+    table[line.slice(0, idx)] = line.slice(idx + 2).split(' | ').map((s) => s.trim()).filter(Boolean);
+  }
+  PARSED[generatorId] = table;
+  return table;
+}
+
+export const PHRASE_BANK_GENERATORS = Object.keys(RAW_BANKS);
+
+/** Returns the complete phrases available for a generator in a language, or an empty list. */
+export function getPhraseBank(generatorId: string, language: string): string[] {
+  return parse(generatorId)[language === 'no' ? 'nb' : language] || [];
+}
