+
+function parseTable(raw: string): Record<string, string[]> {
+  const table: Record<string, string[]> = {};
+  for (const line of raw.split('\n')) {
+    const idx = line.indexOf(' ⇒ ');
+    if (idx < 0) continue;
+    table[line.slice(0, idx)] = line.slice(idx + 3).split('|');
+  }
+  return table;
+}
+
+const MEANINGS = parseTable(MEANINGS_RAW);
+const ORIGIN_FAMILIES = parseTable(ORIGIN_FAMILIES_RAW);
+
+function columnFor(language: LanguageCode | string): number {
+  const index = (TRANSLATION_ORDER_ORIGINAL as readonly string[]).indexOf(String(language));
+  return index >= 0 ? index : 0; // unknown language -> English
+}
+
+/** Translates the meaning of an attested name. French (and unknown source strings) are returned unchanged. */
+export function getLocalizedNameMeaning(meaning: string, requestedLanguage: LanguageCode | string): string {
+  const language = canonicalLanguage(String(requestedLanguage));
+  if (language === 'fr') return meaning;
+  const added = ADDED_NAME_MEANINGS[language]?.[meaning];
+  if (added) return added;
+  const row = MEANINGS[meaning];
+  return row ? row[columnFor(language)] || row[0] : meaning;
+}
+
+/**
+ * Translates an origin such as "Hébreu (Gavri’el)" or "Latin / Grec (Loukas / Lux)".
+ * Language-family names are translated; the original-form hint in parentheses is kept only when it
+ * is a transliterated word (not a French explanatory phrase).
+ */
+export function getLocalizedNameOrigin(origin: string, requestedLanguage: LanguageCode | string): string {
+  const language = canonicalLanguage(String(requestedLanguage));
+  if (language === 'fr') return origin;
+  const column = columnFor(language);
+  const addedFamilies = ADDED_ORIGIN_FAMILIES[language];
+  const cleaned = origin
+    .replace(/\s+via\s+l[’']Espagnol/i, '')
+    .replace(/\s+ou\s+/g, ' / ');
+  return cleaned
+    .replace(/\s*\(([^)]*)\)/g, (_match, inner: string) => {
+      const words = inner.split(/\s+/).filter(Boolean);
+      const isTransliteration = words.length > 0 && words.every((w) => w === '/' || /^[A-ZÀ-Ý]/.test(w));
+      return isTransliteration ? ` (${inner})` : '';
+    })
+    .split(/([ /]+)/)
+    .map((token) => {
+      if (addedFamilies?.[token]) return addedFamilies[token];
+      const row = ORIGIN_FAMILIES[token];
+      return row ? row[column] || row[0] : token;
+    })
+    .join('')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
